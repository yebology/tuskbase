# Server
PORT=8000

# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/tuskbase

# OpenAI
OPENAI_API_KEY=sk-...
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# MemWal
MEMWAL_PRIVATE_KEY=<ed25519-private-key>
MEMWAL_ACCOUNT_ID=<account-id>
MEMWAL_RELAYER_URL=https://relayer.memwal.ai
MEMWAL_NAMESPACE=tuskbase

# Walrus (for content snapshots)
WALRUS_PUBLISHER_URL=https://publisher.walrus-testnet.walrus.space
WALRUS_AGGREGATOR_URL=https://aggregator.walrus-testnet.walrus.space

# Tatum
TATUM_API_KEY=<from-dashboard.tatum.io>
TATUM_SUI_RPC=https://sui-devnet.gateway.tatum.io

# Tavily (web search)
TAVILY_API_KEY=<from-tavily.com>

# Sui
SUI_NETWORK=devnet
TUSKBASE_PACKAGE_ID=<after-deploy>
SUI_PRIVATE_KEY=<sui-ed25519-private-key-hex>
DEFAULT_KNOWLEDGE_BASE_ID=<sui-object-id-of-your-kb>
